// Modelo de dados do Oficina ERP.
// Contrato compartilhado entre Backend e Frontend. Alteração aqui se anuncia no PR.
// Racional das decisões: docs/ARCHITECTURE.md §4 e docs/adr/.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum Role {
  ADMIN
  GERENTE
  ATENDENTE
  MECANICO
}

enum PersonType {
  PF
  PJ
}

enum FuelType {
  GASOLINA
  ETANOL
  FLEX
  DIESEL
  GNV
  ELETRICO
  HIBRIDO
}

enum ServiceOrderStatus {
  ABERTA
  EM_ANDAMENTO
  AGUARDANDO_PECA
  FINALIZADA
  ENTREGUE
  CANCELADA
}

enum QuoteStatus {
  RASCUNHO
  ENVIADO
  APROVADO
  REJEITADO
  EXPIRADO
  CONVERTIDO
}

enum PaymentMethod {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  BOLETO
  TRANSFERENCIA
}

enum StockMovementType {
  ENTRADA
  SAIDA
  AJUSTE
  CONSUMO
  DEVOLUCAO
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  LOGIN
  LOGOUT
}

// ─────────────────────── Acesso e auditoria ───────────────────────

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(ATENDENTE)
  phone        String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?

  mechanic            Mechanic?
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  stockMovements      StockMovement[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([role])
  @@map("users")
}

/// Refresh token rotacionado. Guardamos o hash: vazamento da tabela não dá sessão.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

/// Token de recuperação de senha (ADR-0003). Guardamos o hash, de uso único, curta duração.
model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Auditoria de dados, com valor antes/depois. Nunca é apagada.
/// A referência só tinha log de acesso (ip/url), que não responde "quem mudou este preço".
model AuditLog {
  id        String      @id @default(uuid())
  action    AuditAction
  entity    String
  entityId  String
  before    Json?
  after     Json?
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────── Clientes e veículos ───────────────────────

model Customer {
  id         String     @id @default(uuid())
  personType PersonType @default(PF)
  /// CPF ou CNPJ, somente dígitos. Unique no banco, não só no formulário.
  document   String     @unique
  name       String
  email      String?
  phone      String
  phoneAlt   String?
  zipCode    String?
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?    @db.Char(2)
  notes      String?
  active     Boolean    @default(true)

  vehicles      Vehicle[]
  serviceOrders ServiceOrder[]
  quotes        Quote[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@index([phone])
  @@map("customers")
}

model Vehicle {
  id        String    @id @default(uuid())
  /// Placa normalizada em maiúsculas, sem hífen. Aceita padrão antigo e Mercosul.
  plate     String    @unique
  brand     String
  model     String
  modelYear Int?
  makeYear  Int?
  color     String?
  fuelType  FuelType?
  /// Chassi. Único quando informado.
  vin       String?   @unique
  currentKm Int?
  notes     String?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  serviceOrders ServiceOrder[]
  quotes        Quote[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([customerId])
  @@index([brand, model])
  @@map("vehicles")
}

// ─────────────────────── Catálogos ───────────────────────

model ServiceCategory {
  id       String    @id @default(uuid())
  name     String    @unique
  services Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("service_categories")
}

/// Serviço com preço e tempo estimado — a referência não tinha nenhum dos dois,
/// e o preço era redigitado a cada ordem.
model Service {
  id            String  @id @default(uuid())
  name          String  @unique
  description   String?
  price         Decimal @db.Decimal(12, 2)
  estimatedTime Int? // minutos
  active        Boolean @default(true)

  categoryId String?
  category   ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  serviceOrderServices ServiceOrderService[]
  quoteItems           QuoteItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([categoryId])
  @@map("services")
}

/// Categoria em tabela, não enum de ~70 valores no código: mudar não exige deploy.
model ProductCategory {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_categories")
}

model Supplier {
  id         String  @id @default(uuid())
  /// CNPJ, somente dígitos.
  document   String  @unique
  name       String
  tradeName  String?
  email      String?
  phone      String?
  website    String?
  zipCode    String?
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String? @db.Char(2)
  active     Boolean @default(true)

  products       Product[]
  stockMovements StockMovement[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@map("suppliers")
}

/// Produto com custo, venda e estoque — a referência só tinha preço de venda
/// e nenhuma quantidade.
model Product {
  id           String  @id @default(uuid())
  sku          String  @unique
  barcode      String? @unique
  name         String
  description  String?
  manufacturer String?
  costPrice    Decimal @default(0) @db.Decimal(12, 2)
  salePrice    Decimal @db.Decimal(12, 2)
  unit         String  @default("UN")
  stockQty     Int     @default(0)
  minStockQty  Int     @default(0)
  /// Endereço físico na oficina (ex.: "Prateleira A3"). Texto livre — não há mapa de posições.
  location     String?
  active       Boolean @default(true)

  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId String?
  supplier   Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  serviceOrderItems ServiceOrderItem[]
  quoteItems        QuoteItem[]
  stockMovements    StockMovement[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@index([categoryId])
  @@index([supplierId])
  @@map("products")
}

/// Rastreabilidade do estoque. Append-only: correção é movimento de AJUSTE,
/// nunca UPDATE nem DELETE. `stockQty` do produto é derivado destes registros,
/// e a divergência entre os dois é bug detectável.
model StockMovement {
  id           String            @id @default(uuid())
  type         StockMovementType
  quantity     Int
  unitCost     Decimal?          @db.Decimal(12, 2)
  /// Saldo do produto após o movimento, para auditoria sem recalcular a série.
  resultingQty Int
  reason       String?
  documentRef  String?

  productId String
  product   Product @relation(fields: [productId], references: [id])

  supplierId     String?
  supplier       Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  serviceOrderId String?
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)

  /// Quem movimentou. Sem FK no schema original (Épico 0); a relação entra no
  /// Épico 8 junto da tela que mostra o nome — rastreabilidade sem o nome de
  /// quem registrou não responde "quem fez isso".
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([serviceOrderId])
  @@index([createdAt])
  @@map("stock_movements")
}

// ─────────────────────── Equipe ───────────────────────

model Mechanic {
  id        String    @id @default(uuid())
  name      String
  document  String?   @unique
  phone     String?
  specialty String?
  hiredAt   DateTime?
  active    Boolean   @default(true)

  /// Preenchido quando o mecânico também acessa o sistema.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  serviceOrders        ServiceOrder[]
  serviceOrderServices ServiceOrderService[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("mechanics")
}

// ─────────────────────── Orçamento ───────────────────────

model Quote {
  id     String      @id @default(uuid())
  /// Número visível ao cliente. Separado da PK.
  number Int         @unique @default(autoincrement())
  status QuoteStatus @default(RASCUNHO)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])

  validUntil DateTime?
  notes      String?

  // Calculados no servidor. Valor vindo do cliente é ignorado.
  servicesTotal Decimal @default(0) @db.Decimal(12, 2)
  itemsTotal    Decimal @default(0) @db.Decimal(12, 2)
  discount      Decimal @default(0) @db.Decimal(12, 2)
  total         Decimal @default(0) @db.Decimal(12, 2)

  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  items        QuoteItem[]
  serviceOrder ServiceOrder?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@map("quotes")
}

/// Linha de orçamento: ou serviço, ou produto. A regra "exatamente um dos dois"
/// é validada no service (Prisma não expressa CHECK constraint no schema).
model QuoteItem {
  id          String  @id @default(uuid())
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)

  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quoteId])
  @@map("quote_items")
}

// ─────────────────────── Ordem de serviço ───────────────────────

/// Núcleo do sistema. Referencia cliente E veículo — na referência, a ordem se
/// ligava só ao cliente, o que tornava o histórico por veículo impossível.
model ServiceOrder {
  id     String             @id @default(uuid())
  /// Número que a oficina lê e fala ao telefone. Separado da PK (uuid).
  number Int                @unique @default(autoincrement())
  status ServiceOrderStatus @default(ABERTA)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])

  /// Mecânico responsável pela OS. Cada serviço pode ter outro executor.
  mechanicId String?
  mechanic   Mechanic? @relation(fields: [mechanicId], references: [id], onDelete: SetNull)

  /// KM na entrada: alimenta o histórico e a revisão preventiva.
  entryKm      Int?
  complaint    String?
  diagnosis    String?
  notes        String?
  entryAt      DateTime  @default(now())
  expectedAt   DateTime?
  finishedAt   DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  paymentMethod PaymentMethod?
  paidAt        DateTime?

  // Calculados no servidor a cada escrita. Ver ADR-0004.
  servicesTotal Decimal @default(0) @db.Decimal(12, 2)
  itemsTotal    Decimal @default(0) @db.Decimal(12, 2)
  discount      Decimal @default(0) @db.Decimal(12, 2)
  total         Decimal @default(0) @db.Decimal(12, 2)

  /// Orçamento que originou esta OS, quando houver.
  quoteId String? @unique
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  services       ServiceOrderService[]
  items          ServiceOrderItem[]
  stockMovements StockMovement[]

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([customerId])
  @@index([vehicleId])
  @@index([mechanicId])
  @@index([status])
  @@index([entryAt])
  @@map("service_orders")
}

/// Serviços da OS. N por OS — a referência aceitava exatamente um.
/// `unitPrice` congela o preço na inclusão: reajustar catálogo não reescreve OS antiga.
model ServiceOrderService {
  id        String  @id @default(uuid())
  quantity  Decimal @default(1) @db.Decimal(10, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)
  notes     String?

  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id])

  /// Executor deste serviço, quando difere do responsável pela OS.
  mechanicId String?
  mechanic   Mechanic? @relation(fields: [mechanicId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceOrderId])
  @@index([serviceId])
  @@map("service_order_services")
}

/// Peças da OS. Baixa de estoque acontece na transição para FINALIZADA,
/// dentro da mesma transação que muda o status.
model ServiceOrderItem {
  id        String  @id @default(uuid())
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceOrderId])
  @@index([productId])
  @@map("service_order_items")
}
