# Copie para .env e preencha. NUNCA commite o .env.
# Em produção/CI, cada valor vem de GitHub Secrets (${{ secrets.NOME }}).

# ─── Banco ───
POSTGRES_USER=oficina
POSTGRES_PASSWORD=          # obrigatório
POSTGRES_DB=oficina_erp
POSTGRES_PORT=5432
DATABASE_URL=postgresql://oficina:${POSTGRES_PASSWORD}@db:5432/oficina_erp?schema=public

# ─── Backend ───
NODE_ENV=development
BACKEND_PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Obrigatórios: o backend recusa subir sem eles, em vez de usar um default inseguro.
# Gere cada um com: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Admin inicial (ADR-0006) ───
# Obrigatórios. Sem eles o seed falha dizendo qual falta.
# Não existe senha padrão no código.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ─── Frontend ───
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
